# Database (Neon / Supabase / any Postgres)
# Supabase transaction pooler (port 6543) is supported. Do not add a second URL.
# Production builds derive session mode (port 5432) from this value for
# `npx prisma migrate deploy`, then import the question bank. The app adds
# pgbouncer=true on port 6543 so Prisma does not send prepared statements.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hesi_nclex?sslmode=require"

# Auth.js (Auth.js / NextAuth) — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional OAuth providers (leave blank for credentials/dev login)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App
NEXT_PUBLIC_APP_NAME="HESI RN & NCLEX-RN Practice"
NEXT_PUBLIC_PRACTICE_BENCHMARK_PERCENT="85"

# Exam defaults
EXAM_DEFAULT_QUESTION_COUNT="150"
EXAM_DEFAULT_DURATION_MINUTES="240"
# NCLEX-style 150. The 85-item mode is fixed at 180 minutes.
EXAM_EXTENDED_DURATION_MINUTES="300"
